# AI provider: Verda is used when its key is set, otherwise Claude. Without keys the app uses rules.
# Verda inference (OpenAI-compatible). Create a key in Verda Console → Credentials → Inference API Keys.
VERDA_INFERENCE_API_KEY=
# VERDA_BASE_URL=https://inference.verda.com/v1
# VERDA_DEFAULT_MODEL=deepseek-4-1-flash-1017

ANTHROPIC_API_KEY=
# Optional: override the model
# ANTHROPIC_MODEL=claude-opus-5-5
